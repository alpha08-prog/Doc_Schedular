# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Doc Scheduler"
NODE_ENV=development

# Database — Prisma + PostgreSQL.
# Easiest: run `docker compose up -d` and use the URL below (port 5433).
# Or point this at your own Postgres / a hosted DB (Neon, Supabase, Railway).
DATABASE_URL="postgresql://docscheduler:docscheduler@localhost:5433/docscheduler?schema=public"

# Auth — REQUIRED. Used to sign session JWTs (HS256). Must be >= 32 chars.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-32-plus-char-random-secret"
