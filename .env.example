# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Doc Scheduler"
NODE_ENV=development

# Database — Neon (hosted PostgreSQL). Create a free project at https://neon.tech,
# then from the dashboard's "Connection Details" copy:
#   DATABASE_URL -> the POOLED string (host contains "-pooler"), with
#                   "&pgbouncer=true" appended. Used by the app at runtime.
#   DIRECT_URL   -> the DIRECT string (same, but WITHOUT "-pooler").
#                   Used by `prisma migrate` / `prisma db seed`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth — REQUIRED. Used to sign session JWTs (HS256). Must be >= 32 chars.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-32-plus-char-random-secret"
